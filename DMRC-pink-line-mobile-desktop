<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Delhi Metro — Pink Line</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&family=Noto+Sans+Devanagari:wght@300;400;600&display=swap');

  :root {
    --pink: #E91E8C;
    --pink-light: #FF6BB5;
    --pink-dark: #C2185B;
    --bg: #0A0A12;
    --bg2: #10101E;
    --bg3: #161626;
    --text: #F0EEF8;
    --text-dim: #8880AA;
    --holi1: #FF3D3D;
    --holi2: #FF9500;
    --holi3: #FFE600;
    --holi4: #00D084;
    --holi5: #00B4FF;
    --holi6: #B44EFF;
    --holi7: #FF4FCB;
    --gold: #FFD700;
    --track-width: 6px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Rajdhani', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* NOISE TEXTURE OVERLAY */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 0;
    opacity: 0.5;
  }

  header {
    position: relative;
    z-index: 10;
    padding: 20px 32px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(233,30,140,0.2);
    background: linear-gradient(180deg, rgba(233,30,140,0.08) 0%, transparent 100%);
  }

  .logo-block {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .metro-emblem {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--pink), var(--pink-dark));
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    font-size: 16px;
    color: white;
    box-shadow: 0 0 20px rgba(233,30,140,0.5);
    flex-shrink: 0;
  }

  .header-title {
    display: flex;
    flex-direction: column;
  }

  .header-title h1 {
    font-family: 'Rajdhani', sans-serif;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text);
    line-height: 1;
  }

  .header-title .sub {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--pink-light);
    font-weight: 500;
    margin-top: 3px;
    font-family: 'Space Mono', monospace;
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(233,30,140,0.12);
    border: 1px solid rgba(233,30,140,0.3);
    border-radius: 20px;
    padding: 6px 14px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--pink-light);
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #FF4FCB;
    animation: pulse 1.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.7); }
  }

  /* FESTIVAL BANNER */
  .festival-banner {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 32px;
    background: linear-gradient(90deg, 
      rgba(255,61,61,0.12), rgba(255,149,0,0.12), rgba(255,230,0,0.12),
      rgba(0,208,132,0.12), rgba(0,180,255,0.12), rgba(180,78,255,0.12));
    border-bottom: 1px solid rgba(255,255,255,0.06);
    overflow: hidden;
  }

  .festival-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, 
      rgba(255,61,61,0.05) 0%, rgba(255,230,0,0.05) 33%, rgba(0,180,255,0.05) 66%, rgba(180,78,255,0.05) 100%);
    animation: festivalShift 4s linear infinite;
  }

  @keyframes festivalShift {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  .festival-text {
    font-family: 'Rajdhani', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 1;
    position: relative;
  }

  .holi-dots {
    display: flex;
    gap: 5px;
  }

  .holi-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    animation: holiSpin 2s ease-in-out infinite;
  }

  @keyframes holiSpin {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.4); }
  }

  .festival-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 1;
    position: relative;
  }

  .festival-label {
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 1px;
    font-family: 'Space Mono', monospace;
  }

  .toggle-btn {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 20px;
    padding: 4px 14px;
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: var(--text);
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 1px;
  }

  .toggle-btn.active {
    background: rgba(233,30,140,0.25);
    border-color: var(--pink);
    color: var(--pink-light);
  }

  .toggle-btn:hover {
    background: rgba(255,255,255,0.12);
  }

  /* MAIN LAYOUT */
  .main {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 340px 1fr;
    min-height: calc(100vh - 120px);
  }

  /* SIDEBAR */
  .sidebar {
    border-right: 1px solid rgba(233,30,140,0.15);
    padding: 24px 0;
    overflow-y: auto;
    max-height: calc(100vh - 120px);
    background: linear-gradient(180deg, rgba(233,30,140,0.03) 0%, transparent 30%);
  }

  .sidebar-section {
    padding: 0 24px;
    margin-bottom: 28px;
  }

  .sidebar-label {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--text-dim);
    text-transform: uppercase;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  /* JOURNEY CARD */
  .journey-card {
    background: var(--bg3);
    border: 1px solid rgba(233,30,140,0.2);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 10px;
  }

  .journey-route {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .station-pill {
    flex: 1;
    background: rgba(233,30,140,0.1);
    border: 1px solid rgba(233,30,140,0.25);
    border-radius: 8px;
    padding: 8px 10px;
    text-align: center;
  }

  .station-pill .label {
    font-size: 9px;
    color: var(--text-dim);
    letter-spacing: 1px;
    font-family: 'Space Mono', monospace;
  }

  .station-pill .name {
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .arrow-icon {
    color: var(--pink);
    font-size: 16px;
    flex-shrink: 0;
  }

  .journey-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
  }

  .stat {
    text-align: center;
  }

  .stat .val {
    font-family: 'Space Mono', monospace;
    font-size: 16px;
    font-weight: 700;
    color: var(--pink-light);
    display: block;
  }

  .stat .key {
    font-size: 9px;
    color: var(--text-dim);
    letter-spacing: 1px;
  }

  /* PROGRESS RAY */
  .ray-container {
    background: var(--bg3);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 10px;
  }

  .ray-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .ray-title {
    font-size: 11px;
    letter-spacing: 2px;
    color: var(--text-dim);
    font-family: 'Space Mono', monospace;
  }

  .ray-percent {
    font-family: 'Space Mono', monospace;
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
  }

  .ray-track {
    height: 12px;
    background: rgba(255,255,255,0.06);
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    margin-bottom: 8px;
  }

  .ray-fill {
    height: 100%;
    border-radius: 6px;
    transition: width 0.1s linear;
    position: relative;
    overflow: hidden;
  }

  .ray-fill.normal {
    background: linear-gradient(90deg, var(--pink-dark), var(--pink), var(--pink-light));
    box-shadow: 0 0 12px rgba(233,30,140,0.6);
  }

  .ray-fill.holi {
    background: linear-gradient(90deg, 
      var(--holi1), var(--holi2), var(--holi3), var(--holi4), var(--holi5), var(--holi6), var(--holi7));
    background-size: 200% 100%;
    animation: holiRay 1.5s linear infinite;
    box-shadow: 0 0 16px rgba(255,100,200,0.7);
  }

  @keyframes holiRay {
    0% { background-position: 0% 50%; }
    100% { background-position: 200% 50%; }
  }

  .ray-fill::after {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 20px;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6));
    animation: shimmer 1s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  /* Gulal particles for Holi */
  .gulal-particles {
    position: relative;
    height: 30px;
    display: none;
  }

  .gulal-particles.active {
    display: block;
  }

  .particle {
    position: absolute;
    border-radius: 50%;
    width: 6px;
    height: 6px;
    animation: floatUp 2s ease-out infinite;
    opacity: 0;
  }

  @keyframes floatUp {
    0% { transform: translateY(20px) scale(0); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translateY(-10px) scale(1.5); opacity: 0; }
  }

  .ray-stations {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    color: var(--text-dim);
    font-family: 'Space Mono', monospace;
  }

  .ray-stations span:last-child {
    color: var(--pink-light);
  }

  /* TIME DISPLAY */
  .time-display {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }

  .time-card {
    flex: 1;
    background: var(--bg3);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 12px;
    text-align: center;
  }

  .time-card .t-val {
    font-family: 'Space Mono', monospace;
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    line-height: 1;
  }

  .time-card .t-key {
    font-size: 9px;
    color: var(--text-dim);
    letter-spacing: 1.5px;
    margin-top: 4px;
    display: block;
  }

  .time-card.highlight {
    border-color: rgba(233,30,140,0.3);
    background: rgba(233,30,140,0.05);
  }

  .time-card.highlight .t-val {
    color: var(--pink-light);
  }

  /* CONTROLS */
  .controls {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
  }

  .ctrl-btn {
    width: 100%;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid rgba(233,30,140,0.3);
    background: rgba(233,30,140,0.08);
    color: var(--text);
    font-family: 'Rajdhani', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s;
  }

  .ctrl-btn:hover {
    background: rgba(233,30,140,0.18);
    border-color: var(--pink);
  }

  .ctrl-btn.primary {
    background: linear-gradient(135deg, var(--pink-dark), var(--pink));
    border-color: var(--pink);
    box-shadow: 0 4px 16px rgba(233,30,140,0.35);
  }

  .ctrl-btn.primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(233,30,140,0.5);
  }

  /* STATION LIST */
  .station-list {
    padding: 0 24px;
  }

  .station-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 0;
    cursor: pointer;
    border-bottom: 1px solid rgba(255,255,255,0.03);
    transition: all 0.15s;
  }

  .station-item:hover {
    padding-left: 6px;
  }

  .station-item.active .st-name {
    color: var(--pink-light);
  }

  .station-item.visited .st-dot {
    background: var(--pink);
    box-shadow: 0 0 8px rgba(233,30,140,0.5);
  }

  .station-item.active .st-dot {
    background: white;
    box-shadow: 0 0 12px rgba(255,255,255,0.7);
    animation: activePulse 1s ease-in-out infinite;
  }

  @keyframes activePulse {
    0%, 100% { transform: scale(1); box-shadow: 0 0 12px rgba(255,255,255,0.7); }
    50% { transform: scale(1.4); box-shadow: 0 0 20px rgba(255,255,255,1); }
  }

  .st-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    border: 2px solid rgba(233,30,140,0.4);
    flex-shrink: 0;
  }

  .st-info {
    flex: 1;
    min-width: 0;
  }

  .st-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .st-hindi {
    font-family: 'Noto Sans Devanagari', sans-serif;
    font-size: 10px;
    color: var(--text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .st-num {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: var(--text-dim);
    flex-shrink: 0;
  }

  /* MAP DISPLAY AREA */
  .map-area {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: radial-gradient(ellipse at 50% 40%, rgba(233,30,140,0.06) 0%, transparent 65%);
  }

  .map-display-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 32px 12px;
    border-bottom: 1px solid rgba(233,30,140,0.1);
    flex-shrink: 0;
  }

  .map-display-label {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--pink-light);
    font-weight: 700;
  }

  .map-display-sub {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--text-dim);
  }

  /* SCROLLABLE LINEAR MAP */
  .map-scroll-wrap {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0;
    display: flex;
    align-items: center;
    /* Custom scrollbar */
    scrollbar-width: thin;
    scrollbar-color: rgba(233,30,140,0.4) transparent;
  }

  .map-scroll-wrap::-webkit-scrollbar { height: 4px; }
  .map-scroll-wrap::-webkit-scrollbar-track { background: transparent; }
  .map-scroll-wrap::-webkit-scrollbar-thumb { background: rgba(233,30,140,0.35); border-radius: 2px; }

  /* THE LINEAR MAP CONTAINER */
  .linear-map {
    display: flex;
    flex-direction: column;
    /* Width set by JS based on station count */
    min-height: 320px;
    position: relative;
    padding: 0 40px;
    flex-shrink: 0;
  }

  /* TRACK LINE — absolute, vertically centered */
  .track-line {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 6px;
    transform: translateY(-3px);
    border-radius: 3px;
    background: rgba(233,30,140,0.15);
    z-index: 1;
  }

  /* Visited portion overlay */
  .track-visited {
    position: absolute;
    top: 50%;
    left: 0;
    height: 6px;
    transform: translateY(-3px);
    border-radius: 3px;
    background: linear-gradient(90deg, #C2185B, #E91E8C);
    z-index: 2;
    transition: width 0.12s linear;
    box-shadow: 0 0 10px rgba(233,30,140,0.5);
  }

  /* Active ray overlay (between current station and next) */
  .track-ray {
    position: absolute;
    top: 50%;
    height: 8px;
    transform: translateY(-4px);
    border-radius: 4px;
    z-index: 3;
    transition: left 0.05s linear, width 0.05s linear;
  }

  .track-ray.normal {
    background: linear-gradient(90deg, #C2185B, #FF6BB5);
    box-shadow: 0 0 18px rgba(233,30,140,0.9), 0 0 4px #fff;
  }

  .track-ray.holi {
    background: linear-gradient(90deg,
      #FF3D3D, #FF9500, #FFE600, #00D084, #00B4FF, #B44EFF, #FF4FCB);
    background-size: 300% 100%;
    animation: holiRayMove 1.2s linear infinite;
    box-shadow: 0 0 22px rgba(255,100,200,0.9), 0 0 6px #fff;
  }

  @keyframes holiRayMove {
    0% { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
  }

  /* Moving train head */
  .train-head {
    position: absolute;
    top: 50%;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    transition: left 0.05s linear;
  }

  .train-head.normal {
    background: white;
    box-shadow: 0 0 20px rgba(255,150,220,1), 0 0 6px white;
  }

  .train-head.holi {
    background: white;
    box-shadow: 0 0 24px rgba(255,100,200,1), 0 0 8px white;
    animation: holiHead 0.3s linear infinite;
  }

  @keyframes holiHead {
    0%   { box-shadow: 0 0 24px #FF3D3D, 0 0 8px white; }
    16%  { box-shadow: 0 0 24px #FF9500, 0 0 8px white; }
    33%  { box-shadow: 0 0 24px #FFE600, 0 0 8px white; }
    50%  { box-shadow: 0 0 24px #00D084, 0 0 8px white; }
    66%  { box-shadow: 0 0 24px #00B4FF, 0 0 8px white; }
    83%  { box-shadow: 0 0 24px #B44EFF, 0 0 8px white; }
    100% { box-shadow: 0 0 24px #FF4FCB, 0 0 8px white; }
  }

  /* STATION NODES — positioned absolutely on the linear track */
  .station-node {
    position: absolute;
    top: 50%;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
  }

  /* Label above the track */
  .node-label-above {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 10px;
    transform: translateY(-50%);
  }

  /* Label below the track */
  .node-label-below {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 10px;
    transform: translateY(50%);
  }

  .node-name {
    font-family: 'Rajdhani', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: rgba(200,180,210,0.65);
    white-space: nowrap;
    text-align: center;
    line-height: 1.2;
    max-width: 90px;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s, font-size 0.2s;
  }

  .node-num {
    font-family: 'Space Mono', monospace;
    font-size: 8px;
    color: rgba(150,130,170,0.35);
    margin-top: 2px;
  }

  .node-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid rgba(233,30,140,0.35);
    z-index: 5;
    flex-shrink: 0;
    transition: all 0.2s;
    position: relative;
  }

  /* Interchange station: diamond shape */
  .node-dot.interchange {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    transform: rotate(45deg);
    border-color: var(--gold);
    background: rgba(255,215,0,0.1);
  }

  .station-node.visited .node-dot {
    background: var(--pink);
    border-color: var(--pink);
    box-shadow: 0 0 6px rgba(233,30,140,0.5);
  }

  .station-node.visited .node-dot.interchange {
    background: var(--gold);
    border-color: var(--gold);
  }

  .station-node.visited .node-name {
    color: rgba(255,107,181,0.85);
  }

  .station-node.current .node-dot {
    background: white;
    border-color: white;
    box-shadow: 0 0 16px white, 0 0 6px rgba(255,150,220,1);
    animation: currentPulse 1s ease-in-out infinite;
    width: 14px;
    height: 14px;
  }

  .station-node.current .node-dot.interchange {
