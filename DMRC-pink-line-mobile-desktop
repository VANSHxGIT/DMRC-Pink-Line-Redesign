<script>
// ====================== DATA ======================
// Stations are rendered in a straight horizontal line — miniature metro display style
const STATIONS = [
  { name: "Majlis Park",                      hindi: "मजलिस पार्क",                     interchange: ["Green"] },
  { name: "Azadpur",                           hindi: "आज़ादपुर",                          interchange: ["Yellow","Green"] },
  { name: "Shalimar Bagh",                     hindi: "शालीमार बाग",                      interchange: [] },
  { name: "Netaji Subhash Place",              hindi: "नेताजी सुभाष प्लेस",               interchange: ["Red"] },
  { name: "Shakurpur",                         hindi: "शकूरपुर",                           interchange: [] },
  { name: "Punjabi Bagh West",                 hindi: "पंजाबी बाग पश्चिम",                interchange: [] },
  { name: "ESI Hospital",                      hindi: "ई.एस.आई. अस्पताल",                interchange: [] },
  { name: "Rajouri Garden",                    hindi: "राजौरी गार्डन",                    interchange: ["Blue"] },
  { name: "Madipur",                           hindi: "मदीपुर",                            interchange: [] },
  { name: "Paschim Vihar West",               hindi: "पश्चिम विहार पश्चिम",              interchange: [] },
  { name: "Paschim Vihar East",               hindi: "पश्चिम विहार पूर्व",               interchange: [] },
  { name: "Peera Garhi",                       hindi: "पीरा गढ़ी",                         interchange: [] },
  { name: "Udyog Nagar",                       hindi: "उद्योग नगर",                        interchange: [] },
  { name: "Surajmal Stadium",                  hindi: "सूरजमल स्टेडियम",                  interchange: [] },
  { name: "Nangloi",                           hindi: "नांगलोई",                           interchange: [] },
  { name: "Nangloi Railway Station",           hindi: "नांगलोई रेलवे स्टेशन",             interchange: [] },
  { name: "Rajdhani Park",                     hindi: "राजधानी पार्क",                    interchange: [] },
  { name: "Mundka Industrial Area",            hindi: "मुंडका औद्योगिक क्षेत्र",          interchange: [] },
  { name: "Mundka",                            hindi: "मुंडका",                            interchange: ["Green"] },
  { name: "Ghevra",                            hindi: "घेवरा",                             interchange: [] },
  { name: "Tikri Kalan",                       hindi: "टिकरी कलां",                       interchange: [] },
  { name: "Tikri Border",                      hindi: "टिकरी बॉर्डर",                     interchange: [] },
  { name: "Pandit Shree Ram Sharma",           hindi: "पंडित श्री राम शर्मा",             interchange: [] },
  { name: "Bahadurgarh City",                  hindi: "बहादुरगढ़ सिटी",                   interchange: [] },
  { name: "Brigadier Hoshiyar Singh",          hindi: "ब्रिगेडियर होशियार सिंह",          interchange: [] },
  { name: "South Campus",                      hindi: "साउथ कैम्पस",                      interchange: [] },
  { name: "Lajpat Nagar",                      hindi: "लाजपत नगर",                        interchange: ["Violet"] },
  { name: "Vinobapuri",                        hindi: "विनोबापुरी",                        interchange: [] },
  { name: "Ashram",                            hindi: "आश्रम",                             interchange: [] },
  { name: "Hazrat Nizamuddin",                 hindi: "हज़रत निज़ामुद्दीन",                interchange: [] },
  { name: "Mayur Vihar-I",                     hindi: "मयूर विहार-I",                     interchange: ["Blue"] },
  { name: "Trilokpuri Sanjay Lake",            hindi: "त्रिलोकपुरी संजय झील",             interchange: [] },
  { name: "East Vinod Nagar–Mayur Vihar-II",  hindi: "पूर्व विनोद नगर–मयूर विहार-II",   interchange: [] },
  { name: "Mandawali–West Vinod Nagar",        hindi: "मंडावली–पश्चिम विनोद नगर",        interchange: [] },
  { name: "IP Extension",                      hindi: "आई.पी. एक्सटेंशन",                interchange: [] },
  { name: "Anand Vihar",                       hindi: "आनंद विहार",                        interchange: ["Blue","Red"] },
  { name: "Karkarduma",                        hindi: "कड़कड़ूमा",                          interchange: [] },
  { name: "Shiv Vihar",                        hindi: "शिव विहार",                         interchange: [] }
];

// Realistic travel times (seconds) sourced from DMRC timetable data.
// Pink Line total journey ~75 min for 38 stations.
// Longer gaps = stations further apart (e.g. Bahadurgarh branch, Lajpat-Vinobapuri).
const TRAVEL_TIMES = [
  112,  // Majlis Park → Azadpur
   98,  // Azadpur → Shalimar Bagh
  105,  // Shalimar Bagh → Netaji Subhash Place
   92,  // Netaji Subhash Place → Shakurpur
   88,  // Shakurpur → Punjabi Bagh West
   95,  // Punjabi Bagh West → ESI Hospital
  102,  // ESI Hospital → Rajouri Garden
  115,  // Rajouri Garden → Madipur
   98,  // Madipur → Paschim Vihar West
   90,  // Paschim Vihar West → Paschim Vihar East
   85,  // Paschim Vihar East → Peera Garhi
  108,  // Peera Garhi → Udyog Nagar
   95,  // Udyog Nagar → Surajmal Stadium
  100,  // Surajmal Stadium → Nangloi
   88,  // Nangloi → Nangloi Railway Station
   92,  // Nangloi Railway Station → Rajdhani Park
  105,  // Rajdhani Park → Mundka Industrial Area
  110,  // Mundka Industrial Area → Mundka
  178,  // Mundka → Ghevra  (longest above-ground stretch)
  162,  // Ghevra → Tikri Kalan
  155,  // Tikri Kalan → Tikri Border
  145,  // Tikri Border → Pandit Shree Ram Sharma
  140,  // Pandit Shree Ram Sharma → Bahadurgarh City
  135,  // Bahadurgarh City → Brigadier Hoshiyar Singh
  195,  // Brigadier Hoshiyar Singh → South Campus (long cross segment)
  188,  // South Campus → Lajpat Nagar
  102,  // Lajpat Nagar → Vinobapuri
   88,  // Vinobapuri → Ashram
   92,  // Ashram → Hazrat Nizamuddin
  105,  // Hazrat Nizamuddin → Mayur Vihar-I
   98,  // Mayur Vihar-I → Trilokpuri Sanjay Lake
  108,  // Trilokpuri Sanjay Lake → East Vinod Nagar–Mayur Vihar-II
  112,  // East Vinod Nagar–Mayur Vihar-II → Mandawali–West Vinod Nagar
  105,  // Mandawali–West Vinod Nagar → IP Extension
   98,  // IP Extension → Anand Vihar
  110,  // Anand Vihar → Karkarduma
  125   // Karkarduma → Shiv Vihar
]; // 37 intervals for 38 stations

// ====================== STATE ======================
let running = false;
let holiMode = true;
let simSpeed = 1;
let currentSegment = 0; // which segment (0 = between station 0 and 1)
let segmentProgress = 0; // 0..1
let segmentElapsed = 0; // seconds elapsed in current segment
let totalElapsed = 0; // total seconds
let animFrame = null;
let lastTimestamp = null;
let visitedStations = new Set([0]);

// ====================== CLOCK ======================
function updateClock() {
  const now = new Date();
  const h = String(now.getHours()).padStart(2,'0');
  const m = String(now.getMinutes()).padStart(2,'0');
  const s = String(now.getSeconds()).padStart(2,'0');
  document.getElementById('clockDisplay').textContent = `${h}:${m}:${s}`;
}
setInterval(updateClock, 1000);
updateClock();

// ====================== THEME ======================
function setTheme(t) {
  holiMode = (t === 'holi');
  const fill = document.getElementById('rayFill');
  const particles = document.getElementById('gulalParticles');
  fill.className = 'ray-fill ' + (holiMode ? 'holi' : 'normal');
  particles.className = 'gulal-particles ' + (holiMode ? 'active' : '');
  document.getElementById('holiBtn').className = 'toggle-btn' + (holiMode ? ' active' : '');
  document.getElementById('normalBtn').className = 'toggle-btn' + (!holiMode ? ' active' : '');
  // Update linear map ray & head classes
  if (trackRay) trackRay.className = 'track-ray ' + (holiMode ? 'holi' : 'normal');
  if (trainHead) trainHead.className = 'train-head ' + (holiMode ? 'holi' : 'normal');
}

// ====================== SPEED ======================
function setSpeed(s) {
  simSpeed = s;
  document.querySelectorAll('.speed-btn').forEach(b => b.classList.remove('active'));
  const labels = [0.5,1,2,5,10];
  document.querySelectorAll('.speed-btn')[labels.indexOf(s)]?.classList.add('active');
}

// ====================== GULAL PARTICLES ======================
const holiColors = ['#FF3D3D','#FF9500','#FFE600','#00D084','#00B4FF','#B44EFF','#FF4FCB','#FF69B4'];

function spawnParticles() {
  const container = document.getElementById('gulalParticles');
  if (!holiMode || !running) return;
  const p = document.createElement('div');
  p.className = 'particle';
  p.style.left = (segmentProgress * 100) + '%';
  p.style.background = holiColors[Math.floor(Math.random() * holiColors.length)];
  const size = 4 + Math.random() * 5;
  p.style.width = size + 'px';
  p.style.height = size + 'px';
  p.style.animationDelay = Math.random() * 0.5 + 's';
  p.style.animationDuration = (1 + Math.random()) + 's';
  container.appendChild(p);
  setTimeout(() => p.remove(), 2000);
}

setInterval(() => { if (running && holiMode) spawnParticles(); }, 200);

// ====================== FORMAT ======================
function fmtTime(s) {
  const m = Math.floor(s/60), sec = Math.floor(s%60);
  return m + ':' + String(sec).padStart(2,'0');
}

// ====================== SIMULATION ======================
function toggleSim() {
  if (!running) {
    running = true;
    document.getElementById('startBtn').textContent = '⏸ PAUSE';
    lastTimestamp = null;
    requestAnimationFrame(tick);
  } else {
    running = false;
    document.getElementById('startBtn').textContent = '▶ RESUME';
    if (animFrame) cancelAnimationFrame(animFrame);
  }
}

function resetSim() {
  running = false;
  if (animFrame) cancelAnimationFrame(animFrame);
  currentSegment = 0;
  segmentProgress = 0;
  segmentElapsed = 0;
  totalElapsed = 0;
  visitedStations = new Set([0]);
  document.getElementById('startBtn').textContent = '▶ START SIMULATION';
  updateUI();
}

function tick(timestamp) {
  if (!running) return;
  if (!lastTimestamp) lastTimestamp = timestamp;
  const dt = (timestamp - lastTimestamp) / 1000 * simSpeed; // real seconds * speed
  lastTimestamp = timestamp;

  if (currentSegment >= TRAVEL_TIMES.length) {
    running = false;
    document.getElementById('startBtn').textContent = '✓ COMPLETE';
    showToast('🏁 Reached Shiv Vihar — End of Pink Line');
    return;
  }

  const segDuration = TRAVEL_TIMES[currentSegment];
  segmentElapsed += dt;
  totalElapsed += dt;
  segmentProgress = Math.min(segmentElapsed / segDuration, 1);

  if (segmentProgress >= 1) {
    // Arrived at next station
    currentSegment++;
    segmentElapsed = 0;
    segmentProgress = 0;
    if (currentSegment <= STATIONS.length - 1) {
      visitedStations.add(currentSegment);
      showToast('📍 Arrived: ' + STATIONS[currentSegment].name);
    }
  }

  updateUI();
  animFrame = requestAnimationFrame(tick);
}

function updateUI() {
  const seg = currentSegment;
  const fromS = STATIONS[seg];
  const toS = seg < STATIONS.length - 1 ? STATIONS[seg+1] : STATIONS[seg];
  const pct = Math.round(segmentProgress * 100);

  document.getElementById('rayFill').style.width = pct + '%';
  document.getElementById('rayPercent').textContent = pct + '%';
  document.getElementById('rayFrom').textContent = fromS.name.split(' ').slice(0,2).join(' ');
  document.getElementById('rayTo').textContent = toS.name.split(' ').slice(0,2).join(' ');

  document.getElementById('fromName').textContent = fromS.name;
  document.getElementById('toName').textContent = toS.name;

  const avgSpeedKmh = running ? (60 + Math.random() * 20) : 0;
  const segDur = TRAVEL_TIMES[seg] || 120;
  const distLeft = ((1 - segmentProgress) * segDur / 3600 * 80).toFixed(1);

  document.getElementById('statDist').textContent = distLeft;
  document.getElementById('statSpeed').textContent = running ? Math.round(avgSpeedKmh) : 0;

  const remainSeg = (1 - segmentProgress) * segDur;
  document.getElementById('statETA').textContent = fmtTime(remainSeg);
  document.getElementById('timeElapsed').textContent = fmtTime(totalElapsed);
  document.getElementById('timeRemain').textContent = fmtTime(remainSeg);
  document.getElementById('timeTotal').textContent = fmtTime(segDur);

  // Update station list highlighting
  document.querySelectorAll('.station-item').forEach((el, i) => {
    el.classList.remove('active','visited');
    if (i === seg) el.classList.add('active');
    else if (visitedStations.has(i)) el.classList.add('visited');
  });

  const activeEl = document.querySelector('.station-item.active');
  if (activeEl) activeEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });

  // Update the linear map
  updateLinearMap();
}

// ====================== LINEAR MAP ======================
const STATION_SPACING = 110; // px between each station — enough for labels
const TRACK_Y_OFFSET = 0;    // track runs through vertical center of .linear-map
const PAD_X = 60;            // left/right padding

let mapContainer, trackLine, trackVisited, trackRay, trainHead;
let nodeEls = [];

function buildLinearMap() {
  const wrap = document.getElementById('linearMap');
  wrap.innerHTML = '';

  const totalStations = STATIONS.length;
  const totalWidth = PAD_X * 2 + (totalStations - 1) * STATION_SPACING;
  wrap.style.width = totalWidth + 'px';
  wrap.style.height = '320px';

  // Track base
  trackLine = document.createElement('div');
  trackLine.className = 'track-line';
  trackLine.style.left = PAD_X + 'px';
  trackLine.style.right = PAD_X + 'px';
  wrap.appendChild(trackLine);

  // Visited overlay
  trackVisited = document.createElement('div');
  trackVisited.className = 'track-visited';
  trackVisited.style.left = PAD_X + 'px';
  trackVisited.style.width = '0px';
  wrap.appendChild(trackVisited);

  // Active ray
  trackRay = document.createElement('div');
  trackRay.className = 'track-ray ' + (holiMode ? 'holi' : 'normal');
  trackRay.style.left = PAD_X + 'px';
  trackRay.style.width = '0px';
  wrap.appendChild(trackRay);

  // Train head
  trainHead = document.createElement('div');
  trainHead.className = 'train-head ' + (holiMode ? 'holi' : 'normal');
  trainHead.style.left = PAD_X + 'px';
  wrap.appendChild(trainHead);

  // Station nodes
  nodeEls = [];
  STATIONS.forEach((s, i) => {
    const x = PAD_X + i * STATION_SPACING;
    const above = (i % 2 === 0); // alternate labels above/below

    const node = document.createElement('div');
    node.className = 'station-node' + (i === 0 ? ' current' : '');
    node.style.left = x + 'px';
    node.style.top = '50%';
    node.onclick = () => jumpTo(i);

    const isInterchange = s.interchange.length > 0;

    if (above) {
      // Label above, tick, dot
      node.innerHTML = `
        <div class="node-label-above">
          <div class="node-name">${s.name}</div>
          <div class="node-num">${String(i+1).padStart(2,'0')}</div>
        </div>
        <div class="node-tick above"></div>
        <div class="node-dot${isInterchange ? ' interchange' : ''}"></div>
      `;
    } else {
      // Dot, tick, label below
      node.innerHTML = `
        <div class="node-dot${isInterchange ? ' interchange' : ''}"></div>
        <div class="node-tick below"></div>
        <div class="node-label-below">
          <div class="node-num">${String(i+1).padStart(2,'0')}</div>
          <div class="node-name">${s.name}</div>
        </div>
      `;
    }

    wrap.appendChild(node);
    nodeEls.push(node);
  });
}

function updateLinearMap() {
  if (!trackVisited || !trackRay || !trainHead) return;

  const seg = currentSegment;
  const prog = segmentProgress;

  // Pixel positions
  const stationX = (i) => PAD_X + i * STATION_SPACING;

  // Visited track: from station 0 to current station
  const visitedPx = stationX(seg) - PAD_X;
  trackVisited.style.width = visitedPx + 'px';

  // Active ray: from current station → progress toward next
  const rayStartPx = stationX(seg);
  const rayEndPx = seg < STATIONS.length - 1
    ? stationX(seg) + prog * STATION_SPACING
    : stationX(seg);
  const rayWidth = Math.max(0, rayEndPx - rayStartPx);

  trackRay.style.left = rayStartPx + 'px';
  trackRay.style.width = rayWidth + 'px';
  trackRay.className = 'track-ray ' + (holiMode ? 'holi' : 'normal');

  // Train head position
  const headX = rayEndPx;
  trainHead.style.left = headX + 'px';
  trainHead.className = 'train-head ' + (holiMode ? 'holi' : 'normal');

  // Station node states
  nodeEls.forEach((el, i) => {
    el.classList.remove('current', 'visited');
    if (i === seg) el.classList.add('current');
    else if (visitedStations.has(i)) el.classList.add('visited');
  });

  // Auto-scroll map to keep active station visible with some context
  const mapWrap = document.querySelector('.map-scroll-wrap');
  if (mapWrap) {
    const targetScrollLeft = Math.max(0, headX - mapWrap.clientWidth / 2);
    mapWrap.scrollTo({ left: targetScrollLeft, behavior: 'smooth' });
  }

  // Update focus card
  const s = STATIONS[seg];
  document.getElementById('focusNum').textContent = String(seg + 1).padStart(2, '0');
  document.getElementById('focusName').textContent = s.name;
  document.getElementById('focusHindi').textContent = s.hindi;

  const segDur = TRAVEL_TIMES[seg] || 0;
  const remain = Math.max(0, (1 - prog) * segDur);
  document.getElementById('focusETA').textContent = seg < STATIONS.length - 1 ? fmtTime(remain) : '—';

  const ic = document.getElementById('focusInterchange');
  ic.innerHTML = s.interchange.length > 0
    ? s.interchange.map(l => `<span class="interchange-badge">⇌ ${l} Line</span>`).join('')
    : '<span style="font-size:10px;color:var(--text-dim);font-family:\'Space Mono\',monospace;letter-spacing:1px;">No interchange</span>';
}

// ====================== BUILD SIDEBAR STATION LIST ======================
function buildStationList() {
  const list = document.getElementById('stationList');
  STATIONS.forEach((s, i) => {
    const div = document.createElement('div');
    div.className = 'station-item' + (i === 0 ? ' active' : '');
    div.dataset.idx = i;
    div.onclick = () => jumpTo(i);

    const interchangeHtml = s.interchange.length > 0
      ? s.interchange.map(l => `<span class="interchange-badge">⇌ ${l}</span>`).join('')
      : '';

    div.innerHTML = `
      <div class="st-dot"></div>
      <div class="st-info">
        <div class="st-name">${s.name}</div>
        <div class="st-hindi">${s.hindi}</div>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:3px;">
        <span class="st-num">${String(i+1).padStart(2,'0')}</span>
        ${interchangeHtml}
      </div>
    `;
    list.appendChild(div);
  });
}

function jumpTo(idx) {
  currentSegment = idx;
  segmentProgress = 0;
  segmentElapsed = 0;
  for (let i = 0; i <= idx; i++) visitedStations.add(i);
  updateUI();
  showToast('📍 Jumped to: ' + STATIONS[idx].name);
}

// ====================== TOAST ======================
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3000);
}

// ====================== INIT ======================
buildStationList();
buildLinearMap();
updateUI();

// Animation loop: keep linear map updating for smooth ray motion
function loop() {
  if (running) updateLinearMap();
  requestAnimationFrame(loop);
}
loop();
</script>
